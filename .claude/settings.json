{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -I AGENTES/DOCUMENTOS/ferramentas/extrair_documentos.py *)"
    ],
    "deny": [
      "Read(./LIBERADOS/**)",
      "Edit(./LIBERADOS/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe\" -I \"${CLAUDE_PROJECT_DIR}/AGENTES/DOCUMENTOS/ferramentas/guarda_agente.py\""
          }
        ]
      }
    ]
  }
}
